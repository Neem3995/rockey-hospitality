{
  "info": {
    "_postman_id": "9713263e-2324-4c44-9a5b-23690427255b",
    "name": "Rockey Slice 7 - Event and Registration",
    "description": "Event lifecycle, USER registration ownership/capacity rules, Task Event linkage/filtering, preparation counts, and cancellation history preservation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {"key": "token", "value": "{{adminAccessToken}}", "type": "string"}
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "adminAccessToken", "value": ""},
    {"key": "userAccessToken", "value": ""},
    {"key": "departmentId", "value": ""},
    {"key": "eventId", "value": ""},
    {"key": "eventTaskId", "value": ""},
    {"key": "eventDateTime", "value": ""},
    {"key": "taskDueAt", "value": ""}
  ],
  "item": [
    {
      "name": "List events as USER",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/events?page=0&size=20&sort=eventDateTime,asc"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Canonical page returned', () => pm.expect(pm.response.json()).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages', 'last'));"
        ]}
      }]
    },
    {
      "name": "Create DRAFT event as ADMIN",
      "event": [
        {
          "listen": "prerequest",
          "script": {"exec": [
            "pm.collectionVariables.set('eventDateTime', new Date(Date.now() + 604800000).toISOString().replace('Z', ''));",
            "pm.collectionVariables.set('taskDueAt', new Date(Date.now() + 86400000).toISOString().replace('Z', ''));"
          ]}
        },
        {
          "listen": "test",
          "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Event starts DRAFT with zero preparation work', () => { pm.expect(body.status).to.eql('DRAFT'); pm.expect(body.taskCount).to.eql(0); pm.expect(body.completedTaskCount).to.eql(0); });",
            "pm.collectionVariables.set('eventId', body.id);"
          ]}
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Leadership Conference\",\n  \"description\": \"Slice 7 verification event.\",\n  \"eventDateTime\": \"{{eventDateTime}}\",\n  \"location\": \"Ballroom A\",\n  \"capacity\": 2,\n  \"initialStatus\": \"DRAFT\"\n}"
        },
        "url": "{{baseUrl}}/api/events"
      }
    },
    {
      "name": "Open event as ADMIN",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Leadership Conference\",\n  \"description\": \"Open for registration.\",\n  \"eventDateTime\": \"{{eventDateTime}}\",\n  \"location\": \"Ballroom A\",\n  \"capacity\": 2,\n  \"status\": \"OPEN\"\n}"
        },
        "url": "{{baseUrl}}/api/events/{{eventId}}"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Event is OPEN', () => pm.expect(pm.response.json().status).to.eql('OPEN'));"
        ]}
      }]
    },
    {
      "name": "Get event capacity and preparation",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/events/{{eventId}}"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Capacity and preparation counts exist', () => pm.expect(pm.response.json()).to.include.keys('registeredCount', 'remainingCapacity', 'taskCount', 'completedTaskCount'));"
        ]}
      }]
    },
    {
      "name": "Register current USER",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "POST", "url": "{{baseUrl}}/api/events/{{eventId}}/registrations"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));",
          "pm.test('Registration references Event', () => pm.expect(pm.response.json().event.id).to.eql(Number(pm.collectionVariables.get('eventId'))));"
        ]}
      }]
    },
    {
      "name": "Reject duplicate registration",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "POST", "url": "{{baseUrl}}/api/events/{{eventId}}/registrations"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Duplicate is 409', () => pm.response.to.have.status(409));"
        ]}
      }]
    },
    {
      "name": "List current USER registrations",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "GET", "url": "{{baseUrl}}/api/events/registrations/me?page=0&size=20"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Created Event is registered', () => pm.expect(pm.response.json().content.some(event => event.id === Number(pm.collectionVariables.get('eventId')))).to.eql(true));"
        ]}
      }]
    },
    {
      "name": "Withdraw current USER",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/events/{{eventId}}/registrations/me"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 204', () => pm.response.to.have.status(204));"
        ]}
      }]
    },
    {
      "name": "Register again for cancellation-history check",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "POST", "url": "{{baseUrl}}/api/events/{{eventId}}/registrations"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));"
        ]}
      }]
    },
    {
      "name": "Create Task linked to Event",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare event ballroom\",\n  \"description\": \"Set up the ballroom.\",\n  \"departmentId\": {{departmentId}},\n  \"eventId\": {{eventId}},\n  \"priority\": \"HIGH\",\n  \"dueAt\": \"{{taskDueAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));",
          "const body = pm.response.json();",
          "pm.test('Task has Event summary', () => pm.expect(body.event.id).to.eql(Number(pm.collectionVariables.get('eventId'))));",
          "pm.collectionVariables.set('eventTaskId', body.id);"
        ]}
      }]
    },
    {
      "name": "Filter Tasks by Event",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/tasks?eventId={{eventId}}&page=0&size=20"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Only linked Event tasks returned', () => pm.response.json().content.forEach(task => pm.expect(task.event.id).to.eql(Number(pm.collectionVariables.get('eventId')))));"
        ]}
      }]
    },
    {
      "name": "Cancel Event without hard deletion",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/events/{{eventId}}"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200, not 204', () => pm.response.to.have.status(200));",
          "pm.test('Event remains as CANCELLED history', () => { const body = pm.response.json(); pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('eventId'))); pm.expect(body.status).to.eql('CANCELLED'); pm.expect(body.registeredCount).to.eql(1); pm.expect(body.taskCount).to.be.at.least(1); });"
        ]}
      }]
    },
    {
      "name": "Task history retains cancelled Event",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/tasks/{{eventTaskId}}"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Cancelled Event summary remains linked', () => pm.expect(pm.response.json().event.status).to.eql('CANCELLED'));"
        ]}
      }]
    },
    {
      "name": "Reject registration after cancellation",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "POST", "url": "{{baseUrl}}/api/events/{{eventId}}/registrations"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Cancelled Event registration is 409', () => pm.response.to.have.status(409));"
        ]}
      }]
    },
    {
      "name": "Cancelled Event remains in USER registration history",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{userAccessToken}}", "type": "string"}]
      },
      "request": {"method": "GET", "url": "{{baseUrl}}/api/events/registrations/me?page=0&size=20"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Cancelled registration history is preserved', () => pm.expect(pm.response.json().content.some(event => event.id === Number(pm.collectionVariables.get('eventId')) && event.status === 'CANCELLED')).to.eql(true));"
        ]}
      }]
    }
  ]
}
