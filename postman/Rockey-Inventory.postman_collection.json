{
  "info": {
    "name": "Rockey Slice 8 - Inventory",
    "description": "Run in order on an initialized local MySQL backend. Supply runtime ADMIN/STAFF/USER tokens without saving credentials. Creates an isolated Department and item, verifies guards, then soft-deactivates both. STAFF must belong to a different existing active department. PUT quantity is an absolute count, not a delta. Live execution is environment-dependent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "staffAccessToken",
      "value": ""
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "inventoryDepartmentId",
      "value": ""
    },
    {
      "key": "inventoryItemId",
      "value": ""
    },
    {
      "key": "inventorySku",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create isolated active Department",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/departments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Inventory Slice8 {{$timestamp}}\",\"description\":\"Slice 8 guard verification\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set('inventoryDepartmentId', pm.response.json().id); pm.collectionVariables.set('inventorySku', 'SLICE8-' + Date.now()); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create inventory with normalized SKU",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/inventory",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"  Test Towels  \",\"sku\":\"  {{inventorySku}}  \",\"quantity\":18,\"reorderThreshold\":20,\"departmentId\":{{inventoryDepartmentId}}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('inventoryItemId', pm.response.json().id);",
              "pm.test('Normalized safe DTO', () => { const x=pm.response.json(); pm.expect(x.name).to.eql('Test Towels'); pm.expect(x.sku).to.eql(pm.collectionVariables.get('inventorySku')); pm.expect(x.quantity).to.eql(18); pm.expect(x.reorderThreshold).to.eql(20); pm.expect(x.active).to.eql(true); pm.expect(x.department).to.have.keys('id','name'); ['password','passwordHash','accessToken','refreshToken','refreshTokenHash'].forEach(k=>pm.expect(x).not.to.have.property(k)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "ADMIN scoped page/filter/sort",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inventory?departmentId={{inventoryDepartmentId}}&active=true&page=0&size=5&sort=quantity,desc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Scoped canonical page', () => { const x=pm.response.json(); pm.expect(x).to.include.keys('content','page','size','totalElements','totalPages','last'); pm.expect(x.page).to.eql(0); pm.expect(x.size).to.eql(5); pm.expect(x.content).to.have.lengthOf(1); x.content.forEach(i=>{ pm.expect(String(i.department.id)).to.eql(String(pm.collectionVariables.get('inventoryDepartmentId'))); pm.expect(i.active).to.eql(true); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "ADMIN detail",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/inventory/{{inventoryItemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('SKU retained', () => pm.expect(pm.response.json().sku).to.eql(pm.collectionVariables.get('inventorySku')));"
            ]
          }
        }
      ]
    },
