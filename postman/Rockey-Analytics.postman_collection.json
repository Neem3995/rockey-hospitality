{
  "info": {
    "name": "Rockey Slice 10 — Dashboard and Analytics",
    "description": "Read-only approved analytics contract. Obtain USER/STAFF/ADMIN tokens at runtime; never save credentials/tokens. Use a stable seeded MySQL backend, an eligible STAFF Employee/Department, an existing departmentId, and a genuinely nonexistent positive missingDepartmentId. Run global Inventory/Events before filtered comparison; prevent fixture/scheduler changes during that comparison. For STAFF eligibility failure, manually test dashboard with an otherwise authenticated account whose Employee/Department is missing/inactive (expect 403); do not alter lifecycle guards to fabricate it. Existing domain collections cover lifecycle fixture setup and history retention. Live execution has not been claimed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userAccessToken",
      "value": ""
    },
    {
      "key": "staffAccessToken",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "missingDepartmentId",
      "value": ""
    },
    {
      "key": "floor",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "USER dashboard — own registrations only",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{userAccessToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/api/analytics/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Reference time\", function () { pm.expect(pm.response.json().asOf).to.be.a(\"string\"); });",
              "pm.test(\"Exact USER shape\", function () { const j = pm.response.json(); pm.expect(Object.keys(j).sort()).to.eql([\"asOf\",\"role\",\"user\"]); pm.expect(j.role).to.eql(\"USER\"); pm.expect(Object.keys(j.user)).to.eql([\"registrationCount\"]); pm.expect(j.user.registrationCount).to.be.at.least(0); });"
            ]
          }
        }
      ]
    },
