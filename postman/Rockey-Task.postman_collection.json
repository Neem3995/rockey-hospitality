{
  "info": {
    "_postman_id": "589163a0-56ec-48aa-8db2-6b56e63064f0",
    "name": "Rockey Slice 6 - Task Management",
    "description": "Task CRUD/lifecycle, assignment, assigned-employee work, completion, pagination, overdue filtering, and optional Event references. Set active Department, Employee, Room, and non-cancelled Event IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "adminAccessToken", "value": ""},
    {"key": "staffAccessToken", "value": ""},
    {"key": "departmentId", "value": ""},
    {"key": "employeeId", "value": ""},
    {"key": "roomId", "value": ""},
    {"key": "eventId", "value": ""},
    {"key": "taskId", "value": ""},
    {"key": "cancelTaskId", "value": ""},
    {"key": "dueAt", "value": ""}
  ],
  "item": [
    {
      "name": "Search non-overdue tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks?departmentId={{departmentId}}&overdue=false&page=0&size=20&sort=createdAt,desc"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Canonical page metadata exists', () => pm.expect(pm.response.json()).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages', 'last'));"
        ]}
      }]
    },
    {
      "name": "Search overdue tasks",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks?overdue=true&page=0&size=20&sort=dueAt,asc"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Returned tasks satisfy overdue predicate', () => pm.response.json().content.forEach(task => { pm.expect(task.dueAt).not.to.eql(null); pm.expect(new Date(task.dueAt).getTime()).to.be.below(Date.now()); pm.expect(['COMPLETED','CANCELLED']).not.to.include(task.status); }));"
        ]}
      }]
    },
    {
      "name": "Create unassigned task",
      "event": [
        {
          "listen": "prerequest",
          "script": {"exec": [
            "pm.collectionVariables.set('dueAt', new Date(Date.now() + 86400000).toISOString().replace('Z', ''));"
          ]}
        },
        {
          "listen": "test",
          "script": {"exec": [
            "pm.test('Status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('Unassigned task starts OPEN with Event summary', () => { pm.expect(body.status).to.eql('OPEN'); pm.expect(body.assignedEmployee).to.eql(null); pm.expect(body.event.id).to.eql(Number(pm.collectionVariables.get('eventId'))); });",
            "pm.collectionVariables.set('taskId', body.id);"
          ]}
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman room inspection\",\n  \"description\": \"Inspect room readiness.\",\n  \"departmentId\": {{departmentId}},\n  \"roomId\": {{roomId}},\n  \"eventId\": {{eventId}},\n  \"priority\": \"HIGH\",\n  \"dueAt\": \"{{dueAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "Assign employee",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"employeeId\":{{employeeId}}}"},
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/assigned-employee"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Task becomes ASSIGNED', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ASSIGNED'); pm.expect(body.assignedEmployee.id).to.eql(Number(pm.collectionVariables.get('employeeId'))); });"
        ]}
      }]
    },
    {
      "name": "Get task detail",
      "request": {"method": "GET", "url": "{{baseUrl}}/api/tasks/{{taskId}}"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Correct task returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('taskId'))));"
        ]}
      }]
    },
    {
      "name": "Move assigned task to IN_PROGRESS",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman room inspection\",\n  \"description\": \"Inspection in progress.\",\n  \"departmentId\": {{departmentId}},\n  \"assignedEmployeeId\": {{employeeId}},\n  \"roomId\": {{roomId}},\n  \"eventId\": {{eventId}},\n  \"priority\": \"HIGH\",\n  \"status\": \"IN_PROGRESS\",\n  \"dueAt\": \"{{dueAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Task is IN_PROGRESS', () => pm.expect(pm.response.json().status).to.eql('IN_PROGRESS'));"
        ]}
      }]
    },
    {
      "name": "List own assigned tasks as STAFF",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{staffAccessToken}}", "type": "string"}]
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tasks/assigned/{{employeeId}}?priority=HIGH&overdue=false&page=0&size=20"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Only requested employee tasks returned', () => pm.response.json().content.forEach(task => pm.expect(task.assignedEmployee.id).to.eql(Number(pm.collectionVariables.get('employeeId')))));"
        ]}
      }]
    },
    {
      "name": "Complete assigned task as STAFF",
      "auth": {
        "type": "bearer",
        "bearer": [{"key": "token", "value": "{{staffAccessToken}}", "type": "string"}]
      },
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
      },
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Completion is server recorded', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('COMPLETED'); pm.expect(body.completedAt).not.to.eql(null); });"
        ]}
      }]
    },
    {
      "name": "Create cancellation candidate",
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 201', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('cancelTaskId', pm.response.json().id);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman cancellation candidate\",\n  \"departmentId\": {{departmentId}},\n  \"priority\": \"LOW\",\n  \"dueAt\": \"{{dueAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "Cancel eligible task",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/api/tasks/{{cancelTaskId}}"},
      "event": [{
        "listen": "test",
        "script": {"exec": [
          "pm.test('Status is 200', () => pm.response.to.have.status(200));",
          "pm.test('Task remains as CANCELLED history', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
        ]}
      }]
    }
  ]
}
