{
  "info": {
    "_postman_id": "72ff82cd-1632-45df-bfbe-c3a01b89851a",
    "name": "Rockey Slice 4 - Employee",
    "description": "Employee management checks. Set accessToken to an ADMIN JWT and departmentId to an active Department. This collection creates an Employee without login access, so no password value is stored in the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": ""
    },
    {
      "key": "employeeEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List employees",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees?page=0&size=20&sort=name,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Canonical page metadata exists', () => pm.expect(pm.response.json()).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages', 'last'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List active employees by department",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees?departmentId={{departmentId}}&status=ACTIVE&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returned employees match filters', () => pm.response.json().content.forEach(item => { pm.expect(item.department.id).to.eql(Number(pm.collectionVariables.get('departmentId'))); pm.expect(item.status).to.eql('ACTIVE'); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create employee without login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('employeeEmail', 'employee.' + Date.now() + '@example.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('No login account or secrets returned', () => { const serialized = JSON.stringify(body); pm.expect(body.userId).to.eql(null); pm.expect(serialized).not.to.include('password'); pm.expect(serialized).not.to.include('token'); });",
              "pm.collectionVariables.set('employeeId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Employee\",\n  \"email\": \"{{employeeEmail}}\",\n  \"departmentId\": {{departmentId}},\n  \"jobRole\": \"Room Attendant\",\n  \"createLogin\": false\n}"
        },
        "url": "{{baseUrl}}/api/employees"
      }
    },
    {
      "name": "Get created employee",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct employee returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('employeeId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update created employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Employee Updated\",\n  \"email\": \"{{employeeEmail}}\",\n  \"departmentId\": {{departmentId}},\n  \"jobRole\": \"Senior Room Attendant\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Profile was updated', () => pm.expect(pm.response.json().jobRole).to.eql('Senior Room Attendant'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate created employee",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify employee history remains",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Employee is inactive', () => pm.expect(pm.response.json().status).to.eql('INACTIVE'));"
            ]
          }
        }
      ]
    }
  ]
}
