{
  "info": {
    "_postman_id": "d10d9a06-4726-4b0f-8265-3c35ea28976c",
    "name": "Rockey Phase 2A - Department",
    "description": "Department vertical-slice checks. Run against a local database initialized with database/schema.sql and database/seed-departments.sql. Set accessToken to a STAFF token for reads or an ADMIN token for the complete collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "departmentId",
      "value": ""
    },
    {
      "key": "departmentName",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List all departments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/departments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "List active departments",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/departments?active=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('All returned departments are active', () => pm.response.json().forEach(item => pm.expect(item.active).to.eql(true)));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create department",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('departmentName', 'Phase2A Test ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Created department is active', () => pm.expect(body.active).to.eql(true));",
              "pm.collectionVariables.set('departmentId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{departmentName}}\",\n  \"description\": \"Created by the Phase 2A Postman collection\"\n}"
        },
        "url": "{{baseUrl}}/api/departments"
      }
    },
    {
      "name": "Get created department",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/departments/{{departmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct department returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('departmentId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update created department",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{departmentName}} Updated\",\n  \"description\": \"Updated by the Phase 2A Postman collection\"\n}"
        },
        "url": "{{baseUrl}}/api/departments/{{departmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Name was updated', () => pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('departmentName') + ' Updated'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate created department",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/departments/{{departmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify soft deactivation",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/departments/{{departmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Department row remains inactive', () => pm.expect(pm.response.json().active).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid department",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \" \"\n}"
        },
        "url": "{{baseUrl}}/api/departments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Validation error has required fields', () => { const body = pm.response.json(); pm.expect(body).to.include.keys('timestamp', 'status', 'error', 'message', 'path', 'fieldErrors'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate seeded department",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \" housekeeping \"\n}"
        },
        "url": "{{baseUrl}}/api/departments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing department",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/departments/999999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
