{
  "info": {
    "_postman_id": "d02ea216-31ec-49d7-a766-d20d0366b055",
    "name": "Rockey Slice 5 - Room and Turnover",
    "description": "Room CRUD, filtering, soft deactivation, and the canonical OCCUPIED to READY turnover sequence. Use an ADMIN JWT for the full collection; STAFF may run reads and status transitions when linked to an active Employee and active Department.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "roomNumber",
      "value": ""
    },
    {
      "key": "nextArrivalAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List active rooms",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rooms?active=true&page=0&size=20&sort=roomNumber,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Canonical page metadata exists', () => pm.expect(pm.response.json()).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages', 'last'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create occupied room",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('roomNumber', 'P-' + Date.now().toString().slice(-8));",
              "pm.collectionVariables.set('nextArrivalAt', new Date(Date.now() + 86400000).toISOString().replace('Z', ''));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Room is created as OCCUPIED', () => { pm.expect(body.roomNumber).to.eql(pm.collectionVariables.get('roomNumber')); pm.expect(body.status).to.eql('OCCUPIED'); });",
              "pm.collectionVariables.set('roomId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomNumber\": \"{{roomNumber}}\",\n  \"roomType\": \"STANDARD\",\n  \"floor\": 2,\n  \"initialStatus\": \"OCCUPIED\",\n  \"nextArrivalAt\": \"{{nextArrivalAt}}\"\n}"
        },
        "url": "{{baseUrl}}/api/rooms"
      }
    },
    {
      "name": "Get created room",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rooms/{{roomId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct room returned', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('roomId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update room details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomType\": \"DELUXE\",\n  \"floor\": 3,\n  \"nextArrivalAt\": \"{{nextArrivalAt}}\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/rooms/{{roomId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Details updated without changing workflow state', () => { const body = pm.response.json(); pm.expect(body.roomType).to.eql('DELUXE'); pm.expect(body.floor).to.eql(3); pm.expect(body.status).to.eql('OCCUPIED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Turnover - checkout to DIRTY",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"DIRTY\"}"
        },
        "url": "{{baseUrl}}/api/rooms/{{roomId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('OCCUPIED to DIRTY succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('DIRTY'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Turnover - DIRTY to CLEANING",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"CLEANING\"}"
        },
        "url": "{{baseUrl}}/api/rooms/{{roomId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('DIRTY to CLEANING succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('CLEANING'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Turnover - CLEANING to INSPECTION",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"INSPECTION\"}"
        },
        "url": "{{baseUrl}}/api/rooms/{{roomId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('CLEANING to INSPECTION succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('INSPECTION'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Turnover - INSPECTION to READY",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"READY\"}"
        },
        "url": "{{baseUrl}}/api/rooms/{{roomId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('INSPECTION to READY succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('READY'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Deactivate room",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/rooms/{{roomId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify inactive room history remains",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rooms/{{roomId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 for ADMIN', () => pm.response.to.have.status(200));",
              "pm.test('Room is inactive', () => pm.expect(pm.response.json().active).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}
