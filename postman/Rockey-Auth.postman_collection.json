{
  "info": {
    "_postman_id": "c8166636-dbb5-49df-8390-6a5e30f6c879",
    "name": "Rockey Phase 2B - Authentication",
    "description": "Registration, login, refresh rotation, current-user, and authenticated logout checks. Postman's cookie jar must be enabled so the HttpOnly rockey_refresh cookie can be sent to refresh and expired by logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "RockeyTest9!"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register USER",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('testEmail', 'phase2b.' + Date.now() + '@example.test');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Registration is USER only', () => pm.expect(body.user.role).to.eql('USER'));",
              "pm.test('No password or refresh token is returned', () => { const serialized = JSON.stringify(body); pm.expect(serialized).not.to.include('password'); pm.expect(serialized).not.to.include('refreshToken'); });",
              "pm.test('HttpOnly refresh cookie is set', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly'));",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phase 2B User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Bearer access token is returned', () => { pm.expect(body.tokenType).to.eql('Bearer'); pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Refresh and rotate",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('New access token is returned', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('Rotated HttpOnly cookie is set', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly'));",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh"
      }
    },
    {
      "name": "Current authenticated user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Safe current-user response', () => { const body = pm.response.json(); const serialized = JSON.stringify(body); pm.expect(body.email).to.eql(pm.collectionVariables.get('testEmail')); pm.expect(serialized).not.to.include('password'); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Logout and revoke refresh session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));",
              "pm.test('Response body is empty', () => pm.expect(pm.response.text()).to.eql(''));",
              "pm.test('Refresh cookie is expired', () => { const cookie = pm.response.headers.get('Set-Cookie'); pm.expect(cookie).to.include('rockey_refresh='); pm.expect(cookie).to.include('Max-Age=0'); pm.expect(cookie).to.include('HttpOnly'); });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      }
    }
  ]
}
