# Review/install only after explicit service approval. Private config stays outside releases.
[Unit]
Description=Rockey housekeeping
After=network.target
[Service]
User=rockey
Group=rockey
WorkingDirectory=/opt/rockey/current
EnvironmentFile=/etc/rockey/rockey.env
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_FORWARD_HEADERS_STRATEGY=framework
Environment=ROCKEY_REFRESH_COOKIE_SECURE=true
Environment=ROCKEY_REFRESH_COOKIE_SAME_SITE=Lax
ExecStart=/usr/bin/java -Duser.timezone=America/New_York -jar /opt/rockey/current/app.jar
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
