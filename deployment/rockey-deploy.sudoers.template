# Review only; install after explicit host-permission approval. Replace ROCKEY_DEPLOY_USER with the
# approved SSH deploy account (the Jenkins rockey-deploy-ssh username). Grants exactly one command:
# no wildcards, no shell, no editor, no other unit. Validate and install as root:
#   visudo -cf rockey-deploy.sudoers && install -o root -g root -m 0440 rockey-deploy.sudoers /etc/sudoers.d/rockey-deploy
Defaults:ROCKEY_DEPLOY_USER !requiretty
ROCKEY_DEPLOY_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart rockey.service
